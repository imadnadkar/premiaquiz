{
  "name": "premiaquiz",
  "version": "0.1.0",
  "description": "Create quizzes and surveys with AI-powered question generation and grading.",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js src/",
    "lint:css": "wp-scripts lint-style assets/css/",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "wp-scripts format src/ assets/css/",
    "test": "wp-scripts test-unit-js",
    "test:watch": "wp-scripts test-unit-js --watch",
    "test:coverage": "wp-scripts test-unit-js --coverage",
    "packages-update": "wp-scripts packages-update",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.php": [
      "php -l",
      "composer exec phpcs"
    ],
    "*.js": [
      "wp-scripts lint-js"
    ],
    "*.css": [
      "wp-scripts lint-style"
    ]
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.5",
    "@wordpress/scripts": "^28.0.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^7.0.2"
  }
}
